/*
  Arduino Uno LED Blinking Project
  Blinks an LED connected to Digital Pin 9.
*/

const int LED_PIN = 9;

void setup() {
  pinMode(LED_PIN, OUTPUT);
}

void loop() {
  digitalWrite(LED_PIN, HIGH); // LED ON
  delay(500);                  // Wait 500 ms

  digitalWrite(LED_PIN, LOW);  // LED OFF
  delay(500);                  // Wait 500 ms
}
